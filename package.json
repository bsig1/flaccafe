{
  "name": "flac-cafe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "frontend:dev": "tsc -p frontend/tsconfig.json && vite build --outDir ./frontend/dist --emptyOutDir && vite preview --host 127.0.0.1 --port 1420 --strictPort --outDir ./frontend/dist",
    "preview:smoke": "vite preview --host 127.0.0.1 --port 1421 --strictPort --outDir ./frontend/dist",
    "build": "tsc -p frontend/tsconfig.json && vite build --outDir ./frontend/dist --emptyOutDir",
    "check": "tsc -p frontend/tsconfig.json --noEmit",
    "check:routes": "python scripts/check_backend_routes.py",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:browser": "playwright test --config frontend/playwright.config.ts",
    "test:backend": "powershell -ExecutionPolicy Bypass -File scripts/test_backend.ps1",
    "test": "npm run check && npm run check:routes && npm run test:frontend && npm run test:backend",
    "backend:dev": "powershell -ExecutionPolicy Bypass -File scripts/run_backend.ps1",
    "desktop": "tauri dev",
    "package:msi": "powershell -ExecutionPolicy Bypass -File scripts/build_msi.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.2.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^4.1.7"
  }
}
