{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLAC Cafe",
  "version": "0.2.1",
  "identifier": "app.flaccafe.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FLAC Cafe",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-backend/flaccafe-backend.exe": "flaccafe-backend.exe"
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "wix/cleanup-appdata.wxs"
        ],
        "componentRefs": [
          "FlacCafeAppDataCleanupMarker"
        ]
      }
    }
  }
}
