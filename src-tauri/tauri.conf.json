{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLAC Cafe",
  "version": "0.6.25",
  "identifier": "io.github.bsig1.flaccafe",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FLAC Cafe",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-backend/flaccafe-backend": "flaccafe-backend",
      "../backend/tools/chromaprint/fpcalc.exe": "tools/chromaprint/fpcalc.exe",
      "../backend/tools/cd-rip/cdda2wav.exe": "tools/cd-rip/cdda2wav.exe",
      "../backend/tools/cd-rip/cdrecord.exe": "tools/cd-rip/cdrecord.exe",
      "../backend/tools/cd-rip/cygwin1.dll": "tools/cd-rip/cygwin1.dll",
      "../backend/tools/cd-rip/devdump.exe": "tools/cd-rip/devdump.exe",
      "../backend/tools/cd-rip/isodump.exe": "tools/cd-rip/isodump.exe",
      "../backend/tools/cd-rip/isoinfo.exe": "tools/cd-rip/isoinfo.exe",
      "../backend/tools/cd-rip/isovfy.exe": "tools/cd-rip/isovfy.exe",
      "../backend/tools/cd-rip/mkisofs.exe": "tools/cd-rip/mkisofs.exe",
      "../backend/tools/cd-rip/mount.exe": "tools/cd-rip/mount.exe",
      "../backend/tools/cd-rip/readcd.exe": "tools/cd-rip/readcd.exe",
      "../backend/tools/cd-rip/rscsi.exe": "tools/cd-rip/rscsi.exe",
      "../backend/tools/cd-rip/scgcheck.exe": "tools/cd-rip/scgcheck.exe",
      "../backend/tools/cd-rip/sh.exe": "tools/cd-rip/sh.exe",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "wix/cleanup-appdata.wxs"
        ],
        "componentRefs": [
          "FlacCafeAppDataCleanupMarker"
        ]
      }
    }
  }
}
